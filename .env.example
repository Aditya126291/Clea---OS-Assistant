# Gemini API key (required for GeminiProvider text turns)
GEMINI_API_KEY=your_gemini_api_key_here

# Secondary Gemini API key for real-time voice calls (Phase 3 Gemini Live API)
GEMINI_LIVE_API_KEY=your_secondary_gemini_api_key_here
CLEA_LIVE_MODEL=gemini-3.8-live

# Optional overrides
CLEA_MODEL=gemini-3.8-flash
CLEA_HOST=127.0.0.1
CLEA_PORT=8765
